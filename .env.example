# NestJS API base URL (server-only, không dùng NEXT_PUBLIC_).
# NestJS mặc định chạy port 3000 — chạy client ở port khác (vd: `npm run dev -- -p 3001`).
API_URL=http://localhost:3000

# Khớp AUTH_REFRESH_TOKEN_TTL_SECONDS của server (mặc định 30 ngày) — maxAge cookie refresh token.
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000

# Tile server cho map (Leaflet URL template). Bỏ trống = OpenStreetMap public (chỉ hợp dev / traffic thấp).
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=

# Reverse geocode (Nominatim API, browser gọi thẳng) — tự điền tỉnh/xã khi chọn vị trí. Bỏ trống = OSM public (1 req/s).
NEXT_PUBLIC_GEOCODE_URL=

# socket.io server cho browser (NestJS, cùng port HTTP). Chỉ nhận realtime ticket ngắn hạn, không phải token.
NEXT_PUBLIC_REALTIME_URL=http://localhost:3000

# URL gốc của site (SEO: metadataBase, canonical, sitemap.xml, robots.txt). Không có `/` cuối.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Secret của webhook revalidate (server NestJS gọi POST /api/revalidate, header x-revalidate-secret).
# Tối thiểu 32 ký tự, phải khớp với server. Bỏ trống = tắt webhook (luôn 401).
REVALIDATE_SECRET=

# Base URL ảnh public của bài viết (next/image chỉ cho phép prefix này). Bằng STORAGE_PUBLIC_BASE_URL của server
# nếu server dùng CDN, không thì https://storage.googleapis.com/<FIREBASE_PUBLIC_STORAGE_BUCKET của server>.
# Đọc lúc khởi động / build (next.config.ts) — đổi giá trị phải restart.
ARTICLE_IMAGE_BASE_URL=https://storage.googleapis.com/your-project-id-public
